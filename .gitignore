# Cargo workspace target. The build dir is overridden to
# /tmp/demiurge-build/ at the convention level (see global
# CLAUDE.md), but this catches the default if anyone forgets.
/target

# Python
__pycache__/
*.pyc
*.pyo

# Editor / OS cruft
*~
*.swp
*.swo
\#*\#
.#*
.DS_Store

# IDE caches at workspace root. Per-subproject IDE noise is
# handled by core/abraxas/.gitignore and core/cherrypie/.gitignore.
.idea/
.vscode/
.cache/
.clangd/
.ccls-cache/
compile_commands.json

# Runtime debris. A core dump is ignored, the core/ crate is not.
*.log
core
!core/
*.core
